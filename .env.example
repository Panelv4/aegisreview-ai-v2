# ---- Database -------------------------------------------------------------
# SQLite (zero-config, default):
DATABASE_URL=sqlite:///./aegis.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegisreview

# ---- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, an ephemeral key is generated per process (sessions drop on restart).
SECRET_KEY=
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=14
ALLOW_REGISTRATION=true

# ---- HTTP -----------------------------------------------------------------
CORS_ORIGINS=*
MAX_UPLOAD_MB=5
MAX_REPO_MB=25

# ---- Demo -----------------------------------------------------------------
# Creates demo@aegis.dev / aegis-demo-2024 with a seeded scan on first boot.
SEED_DEMO=true
